# /etc/event-logger/event-logger.env へコピーして必要な値だけ変更する。
EVENT_LOGGER_DB=/var/lib/event-logger/logger.db
EVENT_LOGGER_SOCKET=/run/event-logger/control.sock
EVENT_LOGGER_TIMEZONE=Asia/Tokyo

# GitHub Releases更新をWeb UIへ表示する場合だけ設定する。
# EVENT_LOGGER_UPDATE_REPOSITORY=raspikoubou/24v-event-logger-oss
# EVENT_LOGGER_UPDATE_HELPER=/opt/event-logger/current/packaging/update.sh
# EVENT_LOGGER_UPDATE_WORK_DIR=/var/lib/event-logger/updates
# verified archiveはservice userが書けないroot専用領域へ置く。
# EVENT_LOGGER_UPDATE_VERIFIED_DIR=/var/lib/event-logger-update/verified
# EVENT_LOGGER_UPDATE_SOCKET=/run/event-logger-update/update.sock
# EVENT_LOGGER_UPDATE_STATUS_FILE=/var/lib/event-logger/update-status.json

# 共有パスワードを使う場合だけ有効化する。
# EVENT_LOGGER_AUTH_ENABLED=1
# EVENT_LOGGER_PASSWORD_HASH=scrypt$...
# install/updateが共有鍵を自動生成して永続化する。手動変更する場合は長い乱数を使う。

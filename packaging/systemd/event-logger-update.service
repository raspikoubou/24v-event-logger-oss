[Unit]
Description=24V Event Logger privileged update agent
After=local-fs.target

[Service]
Type=simple
User=root
Group=event-logger
WorkingDirectory=/opt/event-logger
EnvironmentFile=-/etc/event-logger/event-logger.env
ExecStart=/opt/event-logger/current/packaging/run_with_private_sqlite.sh /opt/event-logger/venv/bin/event-logger-update-agent --socket /run/event-logger-update/update.sock --helper /opt/event-logger/current/packaging/update.sh --work-dir /var/lib/event-logger/updates
Restart=on-failure
RestartSec=2
RuntimeDirectory=event-logger-update
RuntimeDirectoryMode=0770
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
